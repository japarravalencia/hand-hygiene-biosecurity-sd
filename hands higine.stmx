	</sim_specs>
	<isee:prefs saved_runs="12" keep="true" show_module_prefix="true" live_update_on_drag="true" show_restore_buttons="false" layer="model" isee:design="Deluxe Prev-Next Blue Green Pastel" isee:design_custom="false" interface_scale_ui="true" interface_max_page_width="10000" interface_max_page_height="10000" interface_min_page_width="0" interface_min_page_height="0" rifp="true">
		<isee:tag_styles>
			<isee:tag_style tag="Interface"/>
			<isee:tag_style tag="Output"/>
			<isee:tag_style tag="Parameter"/>
			<isee:tag_style tag="Policy"/>
		</isee:tag_styles>
	</isee:prefs>
	<isee:multiplayer_settings include_chat="true" allow_observers="false" advance_time_increment="1" max_advance_time_in_ms="0" model_stops_when_players_drop="false" observer_start_page="home_page" enabled="false"/>
	<isee:time_formats default_format="Builtin">
		<isee:time_format name="Builtin" type="adaptive"/>
	</isee:time_formats>
	<isee:number_format_extenders/>
	<default_format/>
	<model_units>
		<unit name="Dimensionless">
			<eqn>1</eqn>
			<alias>dmnl</alias>
			<alias>unitless</alias>
			<alias>fraction</alias>
		</unit>
		<unit name="Weeks">
			<eqn/>
			<alias>wk</alias>
			<alias>week</alias>
		</unit>
	</model_units>
	<model>
		<variables>
			<aux name="time to change compliance" ai_state="C">
				<doc>Average time delay required for store-level operational routines to shift toward desired compliance.</doc>
				<eqn>2.01</eqn>
				<units>Weeks</units>
			</aux>
			<aux name="desired compliance" ai_state="C">
				<doc>Target compliance level determined by leadership priority, social norms, capability, and monitoring, countered by time pressure and complacency.</doc>
				<eqn>MIN(1, MAX(0, base_compliance + management_effect_on_compliance * Management_Emphasis + norms_effect_on_compliance * Norm_Strength + capability_effect_on_compliance * Capability + monitoring_effect_on_compliance * Monitoring_Coverage - time_pressure_effect_on_compliance * time_pressure - complacency_effect_on_compliance * complacency))</eqn>
				<units>dimensionless</units>
			</aux>
			<aux name="base compliance" ai_state="C">
				<doc>Baseline compliance level observed under neutral organizational conditions.</doc>
				<eqn>0.19</eqn>
				<units>dimensionless</units>
			</aux>
			<aux name="management effect on compliance" ai_state="C">
				<doc>Sensitivity of desired compliance to managerial emphasis.</doc>
				<eqn>0.25</eqn>
				<units>dimensionless</units>
			</aux>
			<aux name="norms effect on compliance" ai_state="C">
				<doc>Sensitivity of compliance to prevailing workplace hygiene norms.</doc>
				<eqn>0.20</eqn>
				<units>dimensionless</units>
			</aux>
			<aux name="capability effect on compliance" ai_state="C">
				<doc>Sensitivity of compliance to employee food preparation and safety capability.</doc>
				<eqn>0.25</eqn>
				<units>dimensionless</units>
			</aux>
			<aux name="monitoring effect on compliance" ai_state="C">
				<doc>Sensitivity of compliance to oversight and inspection coverage.</doc>
				<eqn>0.20</eqn>
				<units>dimensionless</units>
			</aux>
			<aux name="time pressure effect on compliance" ai_state="C">
				<doc>Degrading impact of customer rush and order processing time pressure on adherence.</doc>
				<eqn>0.15</eqn>
				<units>dimensionless</units>
			</aux>
			<aux name="complacency effect on compliance" ai_state="C">
				<doc>Degrading impact of operational complacency on target compliance.</doc>
				<eqn>0.32</eqn>
				<units>dimensionless</units>
			</aux>
			<aux name="time to change reputation" ai_state="C">
				<doc>Time constant required for public sentiment and brand reputation to evolve.</doc>
				<eqn>4.01</eqn>
				<units>Weeks</units>
			</aux>
			<aux name="desired reputation" ai_state="C">
				<doc>Target brand reputation shaped by transparency, customer trust, and ongoing contamination cases.</doc>
				<eqn>MIN(1, MAX(0, base_brand_reputation + transparency_effect_on_reputation * transparency + trust_effect_on_reputation * Trust - infections_effect_on_reputation * normalized_infections))</eqn>
				<units>dimensionless</units>
			</aux>
			<aux name="base brand reputation" ai_state="C">
				<doc>Baseline brand reputation of the restaurant chain.</doc>
				<eqn>0.53</eqn>
				<units>dimensionless</units>
			</aux>
			<aux name="transparency effect on reputation" ai_state="C">
				<doc>Positive effect of transparent communication on restoring reputation.</doc>
				<eqn>0.25</eqn>
				<units>dimensionless</units>
			</aux>
			<aux name="trust effect on reputation" ai_state="C">
				<doc>Positive reinforcement of reputation from underlying consumer trust.</doc>
				<eqn>0.35</eqn>
				<units>dimensionless</units>
			</aux>
			<aux name="infections effect on reputation" ai_state="C">
				<doc>Destructive impact of reported foodborne illness outbreaks on brand reputation.</doc>
				<eqn>0.77</eqn>
				<units>dimensionless</units>
			</aux>
			<aux name="time to change trust" ai_state="C">
				<doc>Adjustment time constant for consumer trust attitudes.</doc>
				<eqn>3.00</eqn>
				<units>Weeks</units>
			</aux>
			<aux name="desired trust" ai_state="C">
				<doc>Target level of consumer trust dictated by base loyalty, brand reputation, transparency, and infection spikes.</doc>
				<eqn>MIN(1, MAX(0, base_customer_trust + reputation_effect_on_trust * Reputation + transparency_effect_on_trust * transparency - infections_effect_on_trust * normalized_infections))</eqn>
				<units>dimensionless</units>
			</aux>
			<aux name="base customer trust" ai_state="C">
				<doc>Baseline customer trust in food safety.</doc>
				<eqn>0.59</eqn>
				<units>dimensionless</units>
			</aux>
			<aux name="reputation effect on trust" ai_state="C">
				<doc>Impact of public brand reputation on consumer willingness to trust.</doc>
				<eqn>0.62</eqn>
				<units>dimensionless</units>
			</aux>
			<aux name="transparency effect on trust" ai_state="C">
				<doc>Impact of honest communication on rebuilding customer trust.</doc>
				<eqn>0.20</eqn>
				<units>dimensionless</units>
			</aux>
			<aux name="infections effect on trust" ai_state="C">
				<doc>Direct damage to diner trust caused by active infection outbreaks.</doc>
				<eqn>0.61</eqn>
				<units>dimensionless</units>
			</aux>
			<aux name="base infection rate" ai_state="C">
				<doc>Infection probability per unit of non-compliant volume served.</doc>
				<eqn>0.44</eqn>
				<units>dimensionless</units>
			</aux>
			<aux name="time to resolve infections" ai_state="C">
				<doc>Average duration an active infection incident persists in the active case pool.</doc>
				<eqn>2.02</eqn>
				<units>Weeks</units>
			</aux>
			<aux name="base infections" ai_state="C">
				<doc>Reference benchmark level of infections used to normalize the infection crisis signal.</doc>
				<eqn>4.99</eqn>
				<units>cases</units>
			</aux>
			<aux name="normalized infections" ai_state="C">
				<doc>Dimensionless index of infection severity bounded between zero and one.</doc>
				<eqn>MIN(1, MAX(0, Infections // base_infections))</eqn>
				<units>dimensionless</units>
			</aux>
			<aux name="volume" ai_state="C">
				<doc>Weekly meal customer volume serving as operational exposure to food safety failure.</doc>
				<eqn>revenue // price_per_meal</eqn>
				<units>cases/Weeks</units>
			</aux>
			<aux name="price per meal" ai_state="C">
				<doc>Effective monetization scaling factor relating revenue to meal servings.</doc>
				<eqn>10.0</eqn>
				<units>Billion Dollars/cases</units>
			</aux>
			<aux name="time to change capability" ai_state="C">
				<doc>Time constant required for training, retraining, and process capability development.</doc>
				<eqn>6.00</eqn>
				<units>Weeks</units>
			</aux>
			<aux name="desired capability" ai_state="C">
				<doc>Target capability level supported by leadership resources and monitoring rigor.</doc>
				<eqn>MIN(1, MAX(0, base_capability + management_effect_on_capability * Management_Emphasis + monitoring_effect_on_capability * Monitoring_Coverage))</eqn>
				<units>dimensionless</units>
			</aux>
			<aux name="base capability" ai_state="C">
				<doc>Inherent baseline staff capability without proactive training interventions.</doc>
				<eqn>0.10</eqn>
				<units>dimensionless</units>
			</aux>
			<aux name="management effect on capability" ai_state="C">
				<doc>Influence of managerial investment in staff training on target capability.</doc>
				<eqn>0.40</eqn>
				<units>dimensionless</units>
			</aux>
			<aux name="monitoring effect on capability" ai_state="C">
				<doc>Feedback and correction benefits of inspections on staff capability.</doc>
				<eqn>0.40</eqn>
				<units>dimensionless</units>
			</aux>
			<aux name="time change management emphasis" ai_state="C">
				<doc>Deliberation and rollout time required to adjust executive attention and policies.</doc>
				<eqn>3.00</eqn>
				<units>Weeks</units>
			</aux>
			<aux name="desired management emphasis" ai_state="C">
				<doc>Target executive focus triggered by crisis infections, dampened by commercial throughput pressure and complacency.</doc>
				<eqn>MIN(1, MAX(0, base_management_emphasis + infections_effect_on_management * normalized_infections - time_pressure_effect_on_management * time_pressure - complacency_effect_on_management * complacency))</eqn>
				<units>dimensionless</units>
			</aux>
			<aux name="base management emphasis" ai_state="C">
				<doc>Routine level of management priority given to hygiene standards.</doc>
				<eqn>0.40</eqn>
				<units>dimensionless</units>
			</aux>
			<aux name="infections effect on management" ai_state="C">
				<doc>Crisis reactivity of management emphasis in response to observed food poisoning cases.</doc>
				<eqn>0.60</eqn>
				<units>dimensionless</units>
			</aux>
			<aux name="time pressure effect on management" ai_state="C">
				<doc>Diversion of management focus away from hygiene toward throughput during busy periods.</doc>
				<eqn>0.20</eqn>
				<units>dimensionless</units>
			</aux>
			<aux name="complacency effect on management" ai_state="C">
				<doc>Erosion of managerial emphasis caused by prolonged absence of visible outbreaks.</doc>
				<eqn>0.52</eqn>
				<units>dimensionless</units>
			</aux>
			<aux name="time to change monitoring" ai_state="C">
				<doc>Time required to recruit, train, or schedule restaurant hygiene auditors.</doc>
				<eqn>4.00</eqn>
				<units>Weeks</units>
			</aux>
			<aux name="desired monitoring coverage" ai_state="C">
				<doc>Target audit coverage driven by leadership mandate and outbreaks, eroded by complacency.</doc>
				<eqn>MIN(1, MAX(0, base_monitoring_coverage + management_effect_on_monitoring * Management_Emphasis + infections_effect_on_monitoring * normalized_infections - complacency_effect_on_monitoring * complacency))</eqn>
				<units>dimensionless</units>
			</aux>
			<aux name="base monitoring coverage" ai_state="C">
				<doc>Standard baseline audit coverage across restaurant locations.</doc>
				<eqn>0.30</eqn>
				<units>dimensionless</units>
			</aux>
			<aux name="management effect on monitoring" ai_state="C">
				<doc>Sensitivity of audit deployment to managerial emphasis.</doc>
				<eqn>0.50</eqn>
				<units>dimensionless</units>
			</aux>
			<aux name="infections effect on monitoring" ai_state="C">
				<doc>Emergency expansion of safety inspections when infections are detected.</doc>
				<eqn>0.40</eqn>
				<units>dimensionless</units>
			</aux>
			<aux name="complacency effect on monitoring" ai_state="C">
				<doc>Reduction of audit diligence and frequency when risk is presumed negligible.</doc>
				<eqn>0.69</eqn>
				<units>dimensionless</units>
			</aux>
			<aux name="time to change norms" ai_state="C">
				<doc>Half-year time constant representing organizational culture inertia.</doc>
				<eqn>26.00</eqn>
				<units>Weeks</units>
			</aux>
			<aux name="time to change market value" ai_state="C">
				<doc>Equity investor adjustment delay reflecting quarterly reporting cycles.</doc>
				<eqn>8.00</eqn>
				<units>Weeks</units>
			</aux>
			<aux name="desired market value" ai_state="C">
				<doc>Fundamental valuation based on operating revenue and adjusted for brand reputational premium or discount.</doc>
				<eqn>MIN(max_market_value, MAX(0, base_valuation * (1 + reputation_effect_on_market_value * (Reputation - base_brand_reputation))))</eqn>
				<units>Billion Dollars</units>
			</aux>
			<aux name="max market value" ai_state="C">
				<doc>Theoretical ceiling on enterprise market value.</doc>
				<eqn>200.0</eqn>
				<units>Billion Dollars</units>
			</aux>
			<aux name="base valuation multiple" ai_state="C">
				<doc>Valuation multiple mapping weekly top-line revenue to enterprise valuation.</doc>
				<eqn>0.20</eqn>
				<units>Weeks</units>
			</aux>
			<aux name="reputation effect on market value" ai_state="C">
				<doc>Sensitivity of market equity multiple to brand reputation relative to base.</doc>
				<eqn>0.35</eqn>
				<units>dimensionless</units>
			</aux>
			<aux name="base valuation" ai_state="C">
				<doc>Unadjusted equity valuation calculated from current sales run-rate.</doc>
				<eqn>revenue * base_valuation_multiple</eqn>
				<units>Billion Dollars</units>
			</aux>
			<aux name="reputation loss" ai_state="C">
				<doc>Reputational deficit below historic baseline creating revenue loss.</doc>
				<eqn>MAX(0, base_brand_reputation - Reputation)</eqn>
				<units>dimensionless</units>
			</aux>
			<aux name="trust loss" ai_state="C">
				<doc>Customer trust deficit below historic baseline driving diner avoidance.</doc>
				<eqn>MAX(0, base_customer_trust - Trust)</eqn>
				<units>dimensionless</units>
			</aux>
			<aux name="revenue" ai_state="C">
				<doc>Current weekly revenue eroded by deficits in customer trust and corporate reputation.</doc>
				<eqn>MAX(0, base_revenue * (1 - reputation_loss_revenue_effect * reputation_loss - trust_loss_revenue_effect * trust_loss))</eqn>
				<units>Billion Dollars/Weeks</units>
			</aux>
			<aux name="base revenue" ai_state="C">
				<doc>Normal unhampered weekly revenue capacity.</doc>
				<eqn>50.0</eqn>
				<units>Billion Dollars/Weeks</units>
			</aux>
			<aux name="reputation loss revenue effect" ai_state="C">
				<doc>Fractional loss in revenue per unit of brand reputation deficit.</doc>
				<eqn>0.60</eqn>
				<units>dimensionless</units>
			</aux>
			<aux name="trust loss revenue effect" ai_state="C">
				<doc>Fractional loss in revenue per unit of consumer trust deficit.</doc>
				<eqn>0.60</eqn>
				<units>dimensionless</units>
			</aux>
			<aux name="time pressure" ai_state="C">
				<doc>Operational rush index derived from restaurant throughput demand relative to rated capacity.</doc>
				<eqn>MIN(1, MAX(0, revenue // capacity_1))</eqn>
				<units>dimensionless</units>
			</aux>
			<aux name="capacity 1" ai_state="C">
				<doc>Maximum sustainable customer handling capacity before severe operational strain occurs.</doc>
				<eqn>60.0</eqn>
				<units>Billion Dollars/Weeks</units>
			</aux>
			<aux name="complacency" ai_state="C">
				<doc>First-order smooth of low-infection stability, measuring organizational relaxation of vigilance.</doc>
				<eqn>SMTH1(1 - normalized_infections, complacency_buildup_time, initial_complacency)</eqn>
				<isee:delay_aux/>
				<units>dimensionless</units>
			</aux>
			<aux name="complacency buildup time" ai_state="C">
				<doc>Time delay over which persistent low infection numbers breed cultural complacency.</doc>
				<eqn>12.00</eqn>
				<units>Weeks</units>
			</aux>
			<aux name="initial complacency" ai_state="C">
				<doc>Starting complacency level at time zero.</doc>
				<eqn>0.50</eqn>
				<units>dimensionless</units>
			</aux>
			<aux name="transparency" ai_state="C">
				<doc>Corporate openness regarding safety audit disclosures and contamination communications.</doc>
				<eqn>MIN(1, MAX(0, base_transparency + management_effect_on_transparency * Management_Emphasis))</eqn>
				<units>dimensionless</units>
			</aux>
			<aux name="base transparency" ai_state="C">
				<doc>Baseline legalistic public disclosure level.</doc>
				<eqn>0.10</eqn>
				<units>dimensionless</units>
			</aux>
			<aux name="management effect on transparency" ai_state="C">
				<doc>Degree to which proactive management commitment drives forthright public transparency.</doc>
				<eqn>0.80</eqn>
				<units>dimensionless</units>
			</aux>
			<flow name="adjustment in compliance" ai_state="C">
				<doc>First-order adjustment rate closing the gap between actual compliance and target compliance.</doc>
				<eqn>(desired_compliance - Compliance) // time_to_change_compliance</eqn>
				<units>1/Weeks</units>
			</flow>
			<flow name="adjustment in reputation" ai_state="C">
				<doc>Rate at which market reputation aligns with performance and public disclosures.</doc>
				<eqn>(desired_reputation - Reputation) // time_to_change_reputation</eqn>
				<units>1/Weeks</units>
			</flow>
			<flow name="adjustment in trust" ai_state="C">
				<doc>Weekly adjustment rate aligning customer trust toward the desired trust level.</doc>
				<eqn>(desired_trust - Trust) // time_to_change_trust</eqn>
				<units>1/Weeks</units>
			</flow>
			<flow name="infection rate" ai_state="C">
				<doc>Rate of new customer infections generated by non-compliant food preparation scaled by customer traffic and by the exogenous scandal shock multiplier.</doc>
				<eqn>base_infection_rate * infection_multiplier * (1 - Compliance) * volume</eqn>
				<non_negative/>
				<units>cases/Weeks</units>
			</flow>
			<flow name="infection resolution rate" ai_state="C">
				<doc>Rate at which active illnesses are diagnosed, treated, and resolved.</doc>
				<eqn>Infections // time_to_resolve_infections</eqn>
				<non_negative/>
				<units>cases/Weeks</units>
			</flow>
			<flow name="adjustment in capability" ai_state="C">
				<doc>Net rate of learning, skill acquisition, or attrition in hygiene capability.</doc>
				<eqn>(desired_capability - Capability) // time_to_change_capability</eqn>
				<units>1/Weeks</units>
			</flow>
			<flow name="adjustment in management emphasis" ai_state="C">
				<doc>Adjustment rate of managerial priority toward food hygiene goals.</doc>
				<eqn>(desired_management_emphasis - Management_Emphasis) // time_change_management_emphasis</eqn>
				<units>1/Weeks</units>
			</flow>
			<flow name="adjustment in monitoring coverage" ai_state="C">
				<doc>Rate of deploying or rolling back restaurant hygiene inspection resources.</doc>
				<eqn>(desired_monitoring_coverage - Monitoring_Coverage) // time_to_change_monitoring</eqn>
				<units>1/Weeks</units>
			</flow>
			<flow name="adjustment in norm strength" ai_state="C">
				<doc>Slow social adjustment process through which everyday employee compliance becomes institutionalized culture.</doc>
				<eqn>(Compliance - Norm_Strength) // time_to_change_norms</eqn>
				<units>1/Weeks</units>
			</flow>
			<flow name="adjustment in market value" ai_state="C">
				<doc>Weekly adjustment of enterprise market capitalization toward underlying company valuation.</doc>
				<eqn>(desired_market_value - Market_Value) // time_to_change_market_value</eqn>
				<units>Billion Dollars/Weeks</units>
			</flow>
			<stock name="Compliance" ai_state="C">
				<doc>Fraction of restaurant food safety operating procedures actively complied with by frontline restaurant staff.</doc>
				<eqn>0.61</eqn>
				<inflow>adjustment_in_compliance</inflow>
				<units>dimensionless</units>
			</stock>
			<stock name="Reputation" ai_state="C">
				<doc>Public perception of brand safety and food cleanliness.</doc>
				<eqn>0.66</eqn>
				<inflow>adjustment_in_reputation</inflow>
				<units>dimensionless</units>
			</stock>
			<stock name="Trust" ai_state="C">
				<doc>Customer faith and willingness to dine at the chain without fear of illness.</doc>
				<eqn>0.76</eqn>
				<inflow>adjustment_in_trust</inflow>
				<units>dimensionless</units>
			</stock>
			<stock name="Infections" ai_state="C">
				<doc>Current pool of active customer foodborne illness infection cases linked to the restaurant chain.</doc>
				<eqn>1.99</eqn>
				<inflow>infection_rate</inflow>
				<outflow>infection_resolution_rate</outflow>
				<units>cases</units>
			</stock>
			<stock name="Capability" ai_state="C">
				<doc>Store staff competence, training depth, and hygiene process expertise.</doc>
				<eqn>initial_capability</eqn>
				<inflow>adjustment_in_capability</inflow>
				<units>dimensionless</units>
			</stock>
			<stock name="Management Emphasis" ai_state="C">
				<doc>Degree of executive and store management focus directed at food safety and hygiene adherence.</doc>
				<eqn>initial_management_emphasis</eqn>
				<inflow>adjustment_in_management_emphasis</inflow>
				<units>dimensionless</units>
			</stock>
			<stock name="Monitoring Coverage" ai_state="C">
				<doc>Percentage of store shifts and preparation stations subjected to active safety audits.</doc>
				<eqn>initial_monitoring_coverage</eqn>
				<inflow>adjustment_in_monitoring_coverage</inflow>
				<units>dimensionless</units>
			</stock>
			<stock name="Norm Strength" ai_state="C">
				<doc>Peer culture and internalized behavioral expectations regarding kitchen hygiene.</doc>
				<eqn>0.50</eqn>
				<inflow>adjustment_in_norm_strength</inflow>
				<units>dimensionless</units>
			</stock>
			<stock name="Market Value" ai_state="C">
				<doc>Capital market valuation of the restaurant chain.</doc>
				<eqn>10.0</eqn>
				<inflow>adjustment_in_market_value</inflow>
				<units>Billion Dollars</units>
			</stock>
			<aux name="infection scandal magnitude" ai_state="C">
				<doc>Peak multiplicative severity of the exogenous scandal-triggering contamination event relative to normal infection generation.</doc>
				<eqn>2.5</eqn>
				<units>dimensionless</units>
			</aux>
			<aux name="infection scandal start week" ai_state="C">
				<doc>Simulation week at which the exogenous food safety scandal event (e.g. a contaminated batch or supplier failure) is discovered.</doc>
				<eqn>20</eqn>
				<units>Weeks</units>
			</aux>
			<aux name="infection scandal duration" ai_state="C">
				<doc>Duration of the acute exogenous contamination shock before it is contained at the source.</doc>
				<eqn>2</eqn>
				<units>Weeks</units>
			</aux>
			<aux name="infection multiplier" ai_state="C">
				<doc>Exogenous shock multiplier on the infection generation process. Equals 1 (normal operations) except during the scandal window [start, start+duration), when it steps up to (1 + magnitude), representing a contaminated-batch or supplier-failure event that triggers the crisis, then returns to baseline once the source is contained.</doc>
				<eqn>1 + STEP(infection_scandal_magnitude, infection_scandal_start_week) - STEP(infection_scandal_magnitude, infection_scandal_start_week + infection_scandal_duration)</eqn>
				<units>dimensionless</units>
			</aux>
			<aux name="initial management emphasis" ai_state="C">
				<doc>Calibrated starting level of executive/store management focus on hygiene at simulation start, prior to the scandal.</doc>
				<eqn>0.61</eqn>
				<units>dimensionless</units>
			</aux>
			<aux name="initial monitoring coverage" ai_state="C">
				<doc>Calibrated starting level of audit/inspection coverage at simulation start, prior to the scandal.</doc>
				<eqn>0.31</eqn>
				<units>dimensionless</units>
			</aux>
			<aux name="initial capability" ai_state="C">
				<doc>Calibrated starting level of staff hygiene training/capability at simulation start, prior to the scandal.</doc>
				<eqn>0.22</eqn>
				<units>dimensionless</units>
			</aux>
		</variables>
